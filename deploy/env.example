# Ohana development environment.
# `pnpm setup` copies this file to .env at the repository root.
# The values match deploy/compose.dev.yaml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Provisions the instance administrator on the very first start only;
# an administrator that already exists is never overwritten.
ADMIN_INITIAL_PASSWORD=ohana-dev-admin

DATABASE_URL=postgresql://ohana:ohana@localhost:5433/ohana

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=ohana-dev
STORAGE_SECRET_KEY=ohana-dev-secret
STORAGE_BUCKET=ohana-dev

# The photo upload limit in bytes, per file (issue #17). The default of
# 26214400 (25 MiB) fits phone photos, including iPhone HEIC originals.
#MEDIA_MAX_UPLOAD_BYTES=26214400

# The Web Push reminders' contact address (issue #22); the push services
# reach the operator here about abuse. A real mailto: or https:// address
# keeps an installation's reminders deliverable.
#PUSH_VAPID_SUBJECT=mailto:ohana@example.com
