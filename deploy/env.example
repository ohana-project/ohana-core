# Ohana development environment.
# `pnpm setup` copies this file to .env at the repository root.
# The values match deploy/compose.dev.yaml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgresql://ohana:ohana@localhost:5433/ohana

STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=ohana-dev
STORAGE_SECRET_KEY=ohana-dev-secret
STORAGE_BUCKET=ohana-dev
