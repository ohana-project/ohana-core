# Ohana production deployment environment.
# Copy this file to .env in the same directory as compose.yaml and fill in the
# values before running `docker compose up -d`.

# Required when you build the image yourself. The Ohana image to run, pinned
# to a release version, for example:
#   ghcr.io/ohana-project/ohana-core:v1.2.0
# The Compose file attached to each GitHub release already pins it, so this
# setting is only read by the repository's deploy/compose.yaml. The same
# image provides the migrate, api, and worker services (ADR-0018).
# (Editing carefully: the release workflow deletes this whole block, from
# the first line through the assignment below, from the attached copy.)
OHANA_IMAGE=

# Required. Password of the bundled PostgreSQL's `ohana` user.
# The Compose file assembles DATABASE_URL from it. The database listens only
# on the internal Compose network.
POSTGRES_PASSWORD=

# Host port specification that publishes the api, for example 3000 or
# 127.0.0.1:3000. Without Caddy this port exposes the whole application.
# When the `caddy` profile is enabled, set this to 127.0.0.1:3000 so the api
# stays behind Caddy instead of being reachable over plain HTTP.
OHANA_PORT=3000

# Log level for migrate, api, and worker:
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Required on the very first start. The api provisions the instance
# administrator from it (ADR-0005) and ignores the value afterwards, so once
# you have signed in and changed the password in the administrative area, it
# is safe to remove this line. At least 10 characters.
ADMIN_INITIAL_PASSWORD=

# If the administrative password is ever lost, reset it with the same image
# from the directory containing compose.yaml (all administrative sessions
# are revoked):
#   docker compose run --rm api node src/entrypoints/reset-admin-password.ts --password <new password>

# Object storage (any S3-compatible endpoint).
#
# The defaults point at the bundled single-node RustFS on the internal Compose
# network. Ohana uses S3 path-style addressing (the bucket in the URL path),
# which RustFS, MinIO, and most self-hosted S3-compatible endpoints expect;
# virtual-hosted addressing is not supported.
#
# To use an external S3-compatible store instead, set STORAGE_ENDPOINT to its
# URL and fill in that endpoint's region, keys, and bucket. The bundled RustFS
# then keeps running unused — and it still receives STORAGE_ACCESS_KEY and
# STORAGE_SECRET_KEY in its own environment, so only point Ohana at external
# credentials you accept having inside the (host-internal) Compose network.
# A single-drive RustFS node cannot be expanded in place, so growing beyond
# it means moving objects to a new target (ADR-0009).
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_REGION=us-east-1

# Required. Credentials for object storage: the bundled RustFS's root
# credentials, or the external endpoint's access key pair.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Bucket for originals and derivatives. Created on first start.
STORAGE_BUCKET=ohana

# Caddy settings. Only read when starting with `--profile caddy`.
#
# What Caddy serves:
#   - empty:            https://localhost with a locally issued certificate,
#                       fine for trying it out on the machine itself;
#   - a domain name:    automatic HTTPS through Let's Encrypt, with the plain
#                       port redirecting to it;
#   - `http://<host>`:  plain HTTP, for installations that terminate TLS in
#                       another proxy in front of Caddy.
#
# When Caddy is enabled, also consider setting OHANA_PORT to 127.0.0.1:3000 so
# the api port stays internal.
CADDY_ADDRESS=

# Host ports publishing Caddy when the `caddy` profile is enabled.
OHANA_HTTP_PORT=80
OHANA_HTTPS_PORT=443
