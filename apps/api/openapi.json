  "paths": {
    "/api/health": {
      "get": {
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "degraded"
                          ]
                        }
                      ]
                    },
                    "checks": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "database",
                        "storage"
                      ],
                      "properties": {
                        "database": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "up"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "down"
                              ]
                            }
                          ]
                        },
                        "storage": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "up"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "down"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "status",
                    "checks"
                  ],
                  "properties": {
                    "status": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "degraded"
                          ]
                        }
                      ]
                    },
                    "checks": {
                      "additionalProperties": false,
                      "type": "object",
                      "required": [
                        "database",
                        "storage"
                      ],
                      "properties": {
                        "database": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "up"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "down"
                              ]
                            }
                          ]
                        },
                        "storage": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "up"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "down"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/spaces": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 200,
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "id",
                    "name",
                    "revision",
                    "createdAt",
                    "updatedAt"
                  ],
                  "properties": {
                    "id": {
                      "format": "uuid",
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "revision": {
                      "pattern": "^[0-9]+$",
                      "type": "string"
                    },
                    "createdAt": {
                      "format": "date-time",
                      "type": "string"
                    },
                    "updatedAt": {
                      "format": "date-time",
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
