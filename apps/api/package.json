{
  "name": "@ohana/api",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/entrypoints/server.ts",
    "db:migrate": "tsx src/entrypoints/migrate.ts",
    "admin:reset-password": "tsx src/entrypoints/reset-admin-password.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
